<Window
    x:Class="Calculadora.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Calculadora"
    Width="500"
    Height="750">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Blue">
            <TextBlock x:Name="ResultadoFinal" Text="0"
               Padding="20"
               Margin="10"
               FontSize="90"
               VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Background="Yellow">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1" 
                        Content="7" FontSize="50" Click="AgregarNumero"/>

                <Button Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1" 
                        Content="8" FontSize="50" Click="AgregarNumero"/>

                <Button Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="1" 
                        Content="9" FontSize="50" Click="AgregarNumero"/>


                <Button Grid.Row="0" Grid.Column="3" BorderBrush="Black" BorderThickness="1" 
                        Content="C" FontSize="50" Click="LimpiarPantalla"/>

                <Button Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1" 
                        Content="4" FontSize="50" Click="AgregarNumero"/>

                <Button Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" 
                        Content="5" FontSize="50" Click="AgregarNumero"/>

                <Button Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="1" 
                        Content="6" FontSize="50" Click="AgregarNumero"/>

                <Button Grid.Row="1" Grid.Column="3" BorderBrush="Black" BorderThickness="1" 
                        Content="=" FontSize="50" Click="CalcularResultado"/>



                <Button Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1"
                        Content="1" FontSize="50" Click="AgregarNumero"/>

                <Button Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1"
                        Content="2" FontSize="50" Click="AgregarNumero"/>

                <Button Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="1"
                        Content="3" FontSize="50" Click="AgregarNumero"/>

                <Button Grid.Row="2" Grid.Column="3" BorderBrush="Black" BorderThickness="1"
                        Content="0" FontSize="50" Click="AgregarNumero"/>


                <Button Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1"
                        Content="+" FontSize="50" Click="AgregarSigno"/>

                <Button Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="1"
                        Content="-" FontSize="50" Click="AgregarSigno"/>

                <Button Grid.Row="3" Grid.Column="2" BorderBrush="Black" BorderThickness="1"
                        Content="*" FontSize="50" Click="AgregarSigno"/>

                <Button Grid.Row="3" Grid.Column="3" BorderBrush="Black" BorderThickness="1"
                        Content="/" FontSize="50" Click="AgregarSigno"/>
            </Grid>
        </Grid>
    </Grid>
</Window>