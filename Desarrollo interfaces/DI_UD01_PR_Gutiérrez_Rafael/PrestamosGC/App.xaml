<!--
  APP.XAML = la "caja de recursos" de TODA la aplicación.
  Lo que se define aquí lo pueden usar las tres ventanas (apuntes 2.2 y 2.8).

  LEYENDA de las etiquetas que verás en los comentarios:
    [ENUNCIADO] = lo pide el PDF de la práctica, pero no sale en los apuntes.
    [EXTRA]     = lo he añadido yo por mi cuenta (no está en apuntes ni lo pide el enunciado).
    Sin etiqueta = está en los apuntes.
-->
<Application x:Class="PrestamosGC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="VentanaPrincipal.xaml">
    <!-- StartupUri = la primera ventana que se abre al arrancar la aplicación. -->
    <Application.Resources>

        <!-- ============================================================ -->
        <!-- COLORES (pinceles). Se usan con {StaticResource NombreClave} -->
        <!-- ============================================================ -->

        <!-- Los cinco primeros ya venían en el proyecto de partida -->
        <SolidColorBrush x:Key="ColorPrincipal" Color="#0F6CBD"/>
        <SolidColorBrush x:Key="ColorError" Color="#C42B1C"/>
        <SolidColorBrush x:Key="ColorCorrecto" Color="#0F7B0F"/>
        <SolidColorBrush x:Key="ColorTextoSecundario" Color="#5F5F5F"/>
        <SolidColorBrush x:Key="ColorFondoTarjeta" Color="#FFFFFF"/>

        <!-- [EXTRA] Tres colores nuevos. Los pongo aquí para no escribir
             ningún color dentro de las ventanas (lo pide el ejercicio 4c). -->
        <SolidColorBrush x:Key="ColorTextoClaro" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorFondoGris" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#E0E0E0"/>

        <!-- ============================================================ -->
        <!-- ESTILOS (ejercicio 4b). Un estilo = varias propiedades de una vez -->
        <!--  - Con x:Key: solo se aplica donde lo pidas (Style="{StaticResource ...}") -->
        <!--  - Sin x:Key: se aplica solo a TODOS los controles de ese tipo   -->
        <!-- ============================================================ -->

        <!-- ~~~~~ TEXTOS (TextBlock) ~~~~~ -->

        <!-- Etiqueta que va encima de cada campo del formulario -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
            <!-- Margin="0,10,0,0" = 10 de espacio por arriba (izq, arriba, der, abajo) -->
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <!-- Texto pequeño y gris sin margen (subtítulos, contador, etc.).
             [EXTRA] BasedOn = "copia el estilo Etiqueta y cámbiale solo lo que pongo".
             BasedOn NO sale en los apuntes. -->
        <Style x:Key="Subtitulo" TargetType="TextBlock" BasedOn="{StaticResource Etiqueta}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- [EXTRA] Texto pequeño que va en línea con otros controles (el «Mostrar:») -->
        <Style x:Key="EtiquetaEnLinea" TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Título grande de una ventana -->
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- MENSAJE DE ERROR bajo un campo (lo pide el ejercicio 4b).
             Empieza OCULTO (Collapsed): el código lo pone Visible cuando hay error. -->
        <Style x:Key="MensajeError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ColorError}"/>
            <!-- [ENUNCIADO] TextWrapping="Wrap": si el texto no cabe, salta de línea -->
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- [EXTRA] Las dos columnas de la tarjeta de detalle: etiqueta (gris) y valor -->
        <Style x:Key="FilaEtiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
            <Setter Property="Margin" Value="0,7,24,7"/>
        </Style>

        <Style x:Key="FilaValor" TargetType="TextBlock">
            <!-- Así los textos largos (observaciones) se ven completos -->
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,7"/>
        </Style>

        <!-- ~~~~~ CAMPOS DEL FORMULARIO: mismo alto y mismo margen ~~~~~ -->
        <!-- Estos tres NO llevan x:Key: se aplican solos a TODOS los TextBox,
             ComboBox y DatePicker de la aplicación. -->

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <!-- Centra el texto en vertical dentro de la caja -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- [EXTRA] Separación de las casillas y de los botones de opción -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ~~~~~ BOTONES ~~~~~ -->

        <!-- [EXTRA] Estilo de TODOS los botones: ancho mínimo y márgenes iguales -->
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- BOTÓN PRINCIPAL (lo pide el ejercicio 4b): fondo azul y letras blancas.
             [EXTRA] BasedOn con {x:Type Button} = parte del estilo de todos los botones.
             [EXTRA] Lleva una plantilla propia (ControlTemplate): si solo cambiáramos el
             fondo, al pasar el ratón Windows lo pondría claro y las letras blancas no se leerían. -->
        <Style x:Key="BotonPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorPrincipal}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoClaro}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- ControlTemplate = el "dibujo" del botón (apuntes 2.8) -->
                    <ControlTemplate TargetType="Button">
                        <!-- TemplateBinding = coge el valor de la propiedad del botón (Background, etc.) -->
                        <Border x:Name="borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <!-- ContentPresenter = aquí se pinta el texto del botón (Content) -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Triggers: cambian el aspecto según el estado del botón -->
                        <ControlTemplate.Triggers>
                            <!-- Ratón encima: un poco más transparente -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <!-- Pulsado: todavía más transparente -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <!-- Desactivado: se ve apagado -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borde" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ~~~~~ CONTENEDORES Y DISTRIBUCIÓN ~~~~~ -->

        <!-- [EXTRA] Borde invisible que da margen interior a cada zona de la ventana principal.
             Padding="16,8" = 16 a izquierda y derecha, 8 arriba y abajo. -->
        <Style x:Key="Zona" TargetType="Border">
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <!-- [EXTRA] Cabecera: deja un poco de espacio por debajo -->
        <Style x:Key="Cabecera" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- [EXTRA] El icono de la cabecera, con espacio a su derecha -->
        <Style x:Key="IconoCabecera" TargetType="Image">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- [EXTRA] Círculo azul de la ventana de detalle (CornerRadius = la mitad del tamaño -> círculo) -->
        <Style x:Key="Avatar" TargetType="Border">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Background" Value="{StaticResource ColorPrincipal}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- TARJETA: el Border blanco de la ventana de detalle (lo pide el ejercicio 4b) -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorFondoTarjeta}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>

        <!-- [EXTRA] Línea fina gris que separa las filas de la tarjeta.
             BorderThickness="0,0,0,1" = solo se dibuja el borde de ABAJO. -->
        <Style x:Key="Separador" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <!-- Que no moleste al ratón -->
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Barra de estado: fondo gris claro, ocupa todo el ancho (ejercicio 1b) -->
        <Style x:Key="BarraEstado" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorFondoGris}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>

        <!-- [EXTRA] Fila de botones pegada a la derecha -->
        <Style x:Key="BarraBotones" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>

        <!-- [EXTRA] Panel de los tres RadioButton del motivo: misma altura que las cajas de texto -->
        <Style x:Key="GrupoOpciones" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- [EXTRA] Celdas del formulario: dejan 8 de hueco entre la columna izquierda y la derecha -->
        <Style x:Key="CeldaIzquierda" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CeldaDerecha" TargetType="StackPanel">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

    </Application.Resources>
</Application>
