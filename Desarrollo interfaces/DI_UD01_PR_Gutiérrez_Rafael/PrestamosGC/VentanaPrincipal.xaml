<!--
  VENTANA PRINCIPAL: lista de préstamos, filtros, botones y barra de estado.
  Etiquetas: [ENUNCIADO] = lo pide el PDF de la práctica (no sale en apuntes) · [EXTRA] = añadido por mí.
-->
<Window x:Class="PrestamosGC.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préstamo de portátiles · Dpto. de Informática"
        Icon="/Recursos/portatil.png"
        Width="760" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <!-- Title: texto de la barra de título.
         Width/Height: tamaño inicial. MinWidth/MinHeight: tamaño mínimo (no se puede encoger más).
         WindowStartupLocation="CenterScreen": se abre en el centro de la pantalla.
         Closing="Window_Closing": método de C# que se ejecuta cuando se va a cerrar la ventana.
         [EXTRA] Icon: icono de la ventana (el mismo dibujo del portátil). -->

    <!-- El Grid reparte la ventana en 5 FILAS de arriba abajo:
         Auto = solo lo que ocupe su contenido · * = todo el espacio que sobra.
         Solo la fila de la lista es "*", así que es la única que crece al agrandar la ventana. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- fila 0: cabecera -->
            <RowDefinition Height="Auto"/>  <!-- fila 1: filtros -->
            <RowDefinition Height="*"/>     <!-- fila 2: lista (la que crece) -->
            <RowDefinition Height="Auto"/>  <!-- fila 3: botones -->
            <RowDefinition Height="Auto"/>  <!-- fila 4: barra de estado -->
        </Grid.RowDefinitions>

        <!-- ===================== CABECERA ===================== -->
        <!-- Grid.Row="0" = propiedad adjunta: le dice al Border en qué fila del Grid va.
             [EXTRA] Border con el estilo "Zona": solo sirve para dar margen interior a los lados. -->
        <Border Grid.Row="0" Style="{StaticResource Zona}">
            <!-- Otro Grid, pero con 2 COLUMNAS: la imagen (Auto) y los textos (*) -->
            <Grid Style="{StaticResource Cabecera}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Image: Source = ruta de la imagen (marcada como Resource en el .csproj)
                     Height="48": alto fijo (lo pide el enunciado).
                     Stretch="Uniform": se ajusta al alto sin deformarse. -->
                <Image Grid.Column="0"
                       Style="{StaticResource IconoCabecera}"
                       Source="/Recursos/portatil.png"
                       Height="48"
                       Stretch="Uniform"/>

                <!-- Los dos textos, uno debajo del otro, centrados en vertical -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Titulo}" Text="Préstamos de portátiles"/>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="Departamento de Informática · IES Gran Capitán"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== FILTROS ===================== -->
        <Border Grid.Row="1" Style="{StaticResource Zona}">
            <!-- StackPanel horizontal: coloca los controles uno al lado del otro -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource EtiquetaEnLinea}" Text="Mostrar:"/>

                <!-- Los 4 RadioButton comparten GroupName="Filtro": solo uno puede estar marcado.
                     x:Name = nombre para usarlos desde C# (rbTodos.IsChecked...).
                     Checked="Filtro_Checked": los cuatro llaman al MISMO método de C#. -->
                <RadioButton x:Name="rbTodos" Content="Todos" GroupName="Filtro"
                             IsChecked="True" Checked="Filtro_Checked"/>
                <RadioButton x:Name="rbActivos" Content="En préstamo" GroupName="Filtro"
                             Checked="Filtro_Checked"/>
                <RadioButton x:Name="rbVencidos" Content="Vencidos" GroupName="Filtro"
                             Checked="Filtro_Checked"/>
                <RadioButton x:Name="rbDevueltos" Content="Devueltos" GroupName="Filtro"
                             Checked="Filtro_Checked"/>
            </StackPanel>
        </Border>

        <!-- ===================== LISTA DE PRÉSTAMOS ===================== -->
        <Border Grid.Row="2" Style="{StaticResource Zona}">
            <!-- ListBox: lista de elementos.
                 DisplayMemberPath="Resumen": de cada Prestamo se muestra su propiedad Resumen.
                 SelectionMode="Single": solo se puede seleccionar uno.
                 SelectionChanged: se lanza al elegir otro elemento.
                 [ENUNCIADO] MouseDoubleClick: se lanza al hacer doble clic. -->
            <ListBox x:Name="lstPrestamos"
                     DisplayMemberPath="Resumen"
                     SelectionMode="Single"
                     SelectionChanged="Lista_SelectionChanged"
                     MouseDoubleClick="Lista_MouseDoubleClick">

                <!-- [EXTRA] Estilo de cada fila de la lista: los préstamos vencidos salen en rojo.
                     DataTrigger = "si el dato cumple la condición, cambia la propiedad" (apuntes 2.8).
                     Aquí: si EstaVencido es True -> letra roja. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EstaVencido}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ColorError}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- ===================== BOTONES ===================== -->
        <Border Grid.Row="3" Style="{StaticResource Zona}">
            <StackPanel Style="{StaticResource BarraBotones}">
                <!-- IsEnabled="False": empieza desactivado; el código lo activa al seleccionar un préstamo -->
                <Button x:Name="btnDetalle" Content="Ver detalle"
                        IsEnabled="False" Click="Detalle_Click"/>
                <!-- Style="{StaticResource BotonPrincipal}": usa el estilo azul de App.xaml -->
                <Button x:Name="btnNuevo" Content="Nuevo préstamo"
                        Style="{StaticResource BotonPrincipal}" Click="Nuevo_Click"/>
            </StackPanel>
        </Border>

        <!-- ===================== BARRA DE ESTADO ===================== -->
        <!-- Border sin márgenes laterales: así el fondo gris ocupa todo el ancho -->
        <Border Grid.Row="4" Style="{StaticResource BarraEstado}">
            <!-- El texto lo rellena el código C# (CargarLista) -->
            <TextBlock x:Name="txtEstado"
                       FontSize="12"
                       Foreground="{StaticResource ColorTextoSecundario}"/>
        </Border>
    </Grid>
</Window>
