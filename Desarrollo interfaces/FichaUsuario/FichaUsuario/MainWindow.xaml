<!-- x:Class une este XAML con la clase MainWindow del archivo .xaml.cs.
     Debe coincidir con el namespace de tu proyecto (FichaUsuario). -->
<Window x:Class="FichaUsuario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ficha de usuario"
        Width="400"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">
    <!-- SizeToContent="Height": la altura se ajusta al contenido, no hace falta Height.
         ResizeMode="CanMinimize": se puede minimizar pero no cambiar de tamaño.
         Loaded: se ejecuta Window_Loaded (en el .cs) cuando la ventana termina de abrirse. -->

    <!-- Grid principal: Margin="16" deja un borde de 16 px alrededor -->
    <Grid Margin="16">

        <!-- 2 columnas: etiquetas (Auto = lo justo) y controles (* = el resto) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 7 filas, una por elemento. Auto = la fila mide lo que necesita su contenido.
             Las filas se numeran desde 0: Nombre=0, Correo=1, Ciudad=2, Fecha=3,
             Casilla=4, Botón=5, Resumen=6 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fila 0: Nombre.
             Margin="izquierda,arriba,derecha,abajo":
             la etiqueta deja 8 px a la derecha y 8 abajo; el control, solo 8 abajo.
             MaxLength limita los caracteres que se pueden escribir. -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:"
                   Margin="0,0,8,8" VerticalAlignment="Center"/>
        <TextBox x:Name="txtNombre" Grid.Row="0" Grid.Column="1"
                 MaxLength="60" Margin="0,0,0,8"/>

        <!-- Fila 1: Correo -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Correo:"
                   Margin="0,0,8,8" VerticalAlignment="Center"/>
        <TextBox x:Name="txtCorreo" Grid.Row="1" Grid.Column="1"
                 MaxLength="100" Margin="0,0,0,8"/>

        <!-- Fila 2: Ciudad.
             No hay ComboBoxItem: las ciudades se cargan desde la BD en el .cs.
             DisplayMemberPath: propiedad que VE el usuario (Nombre).
             SelectedValuePath: propiedad que se usa como valor interno (Id).
             IsEditable="False": solo se puede elegir de la lista. -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ciudad:"
                   Margin="0,0,8,8" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbCiudad" Grid.Row="2" Grid.Column="1"
                  DisplayMemberPath="Nombre" SelectedValuePath="Id"
                  IsEditable="False" Margin="0,0,0,8"/>

        <!-- Fila 3: Fecha. La fecha de hoy se pone desde el .cs, en Loaded. -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha:"
                   Margin="0,0,8,8" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpFecha" Grid.Row="3" Grid.Column="1"
                    Margin="0,0,0,8"/>

        <!-- Fila 4: Casilla. No lleva etiqueta; su texto va en Content.
             Checked se dispara al marcar y Unchecked al desmarcar.
             Los dos llaman al mismo método del .cs. -->
        <CheckBox x:Name="chkCondiciones" Grid.Row="4" Grid.Column="1"
                  Content="Acepto condiciones" Margin="0,0,0,8"
                  Checked="chkCondiciones_Changed"
                  Unchecked="chkCondiciones_Changed"/>

        <!-- Fila 5: Botón Guardar.
             IsEnabled="False": empieza deshabilitado.
             IsDefault="True": se activa al pulsar Intro.
             HorizontalAlignment="Left": no se estira a todo el ancho.
             Click: método que se ejecuta al pulsarlo. -->
        <Button x:Name="btnGuardar" Grid.Row="5" Grid.Column="1"
                Content="Guardar" IsEnabled="False" IsDefault="True"
                HorizontalAlignment="Left" Padding="16,4" Margin="0,0,0,8"
                Click="btnGuardar_Click"/>

        <!-- Fila 6: Resumen. Grid.ColumnSpan="2" hace que ocupe las dos columnas.
             Empieza vacío (sin Text). -->
        <TextBlock x:Name="txtResumen" Grid.Row="6" Grid.Column="0"
                   Grid.ColumnSpan="2" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</Window>