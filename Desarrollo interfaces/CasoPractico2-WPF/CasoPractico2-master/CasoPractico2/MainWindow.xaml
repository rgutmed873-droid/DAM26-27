<!-- MAINWINDOW.XAML: define QUÉ controles hay en la ventana y DÓNDE están.
     Lo que hacen (al pulsar un botón, etc.) está en MainWindow.xaml.cs.
     Los controles con x:Name se pueden usar desde el .cs (por ejemplo txtNombre.Text). -->
<Window x:Class="Habitos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de hábitos diarios"
        Width="640" Height="460"
        MinWidth="600" MinHeight="380"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- DockPanel: pega cada control a un lado (arriba, abajo...).
         El ÚLTIMO control ocupa todo el espacio que queda (aquí, la tabla).
         Importante: el orden en que se escriben importa. -->
    <DockPanel Margin="10">

        <!-- ABAJO: barra de estado con un texto a la izquierda y el total a la derecha -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="txtTotal"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="txtEstado" Text="Listo"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ARRIBA: formulario. Una fila con los datos y otra con los botones -->
        <GroupBox Header="Datos del hábito" DockPanel.Dock="Top" Padding="6">
            <StackPanel>

                <!-- Orientation="Horizontal": los controles van uno al lado de otro -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Nombre:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtNombre" Width="160" MaxLength="50" Margin="0,0,14,0"/>

                    <TextBlock Text="Cantidad:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtCantidad" Width="60" MaxLength="9" Margin="0,0,14,0"/>

                    <TextBlock Text="Fecha:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker x:Name="dpFecha" Width="110"/>
                </StackPanel>

                <!-- Botones. Click = método del .cs que se ejecuta al pulsar.
                     Modificar y Eliminar empiezan desactivados (IsEnabled="False")
                     y se activan al elegir una fila de la tabla. -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnAnadir" Content="Añadir" Width="80" Margin="0,0,8,0"
                            IsDefault="True" Click="btnAnadir_Click"/>
                    <Button x:Name="btnModificar" Content="Modificar" Width="80" Margin="0,0,8,0"
                            IsEnabled="False" Click="btnModificar_Click"/>
                    <Button x:Name="btnEliminar" Content="Eliminar" Width="80" Margin="0,0,8,0"
                            IsEnabled="False" Click="btnEliminar_Click"/>
                    <Button x:Name="btnLimpiar" Content="Limpiar" Width="80"
                            Click="btnLimpiar_Click"/>
                </StackPanel>

            </StackPanel>
        </GroupBox>

        <!-- CENTRO: tabla con los hábitos. Es el último control, así que ocupa el resto.
             Los datos se los da el .cs con dgHabitos.ItemsSource = lista.
             AutoGenerateColumns="False": las columnas las definimos a mano (abajo).
             IsReadOnly="True": no se puede escribir dentro de la tabla.
             SelectionChanged: se ejecuta al elegir otra fila. -->
        <DataGrid x:Name="dgHabitos" Margin="0,10,0,10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="dgHabitos_SelectionChanged">
            <DataGrid.Columns>
                <!-- Binding="{Binding Nombre}" = enseña la propiedad Nombre de cada Habito -->
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Hábito" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
